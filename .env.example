# SGMakan Environment Variables
# Copy this file to .env and fill in your values
# Get credentials from: https://supabase.com/dashboard/project/_/settings/api

# ===========================================
# React Frontend (must start with REACT_APP_)
# ===========================================
REACT_APP_SUPABASE_URL=your_supabase_project_url
REACT_APP_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# ===========================================
# Node.js Scripts (seed, AI discovery)
# Uses service_role key for bypassing RLS
# ===========================================
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_service_role_key

# ===========================================
# Serper (Google Search API)
# Get your key at: https://serper.dev
# ===========================================
SERPER_API_KEY=your_serper_api_key

# ===========================================
# AI Providers (at least one required)
# Pipeline tries: OpenRouter → Groq → Gemini
# ===========================================

# OpenRouter (primary)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# Groq (fallback — free: 30 RPM, 1000 RPD)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (fallback)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash-lite
